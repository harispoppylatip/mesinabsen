# Salin berkas ini menjadi .env bila perlu mengubah pengaturan bawaan.
# Semua nilai di bawah sudah punya bawaan di docker-compose.yml, jadi .env
# tidak wajib dibuat.

# Alamat tempat port layanan wajah dibuka di komputer ini.
#
# 127.0.0.1  hanya bisa dihubungi dari komputer ini sendiri (bawaan, paling aman).
# 0.0.0.0    bisa dihubungi dari komputer lain di jaringan sekolah.
#
# Layanan ini tidak punya kata sandi, jadi 0.0.0.0 hanya dipakai bila mesin
# wajahnya memang dipisah dari aplikasi sekolah, dan sebaiknya dibatasi
# firewall.
FACE_PUBLISH_HOST=127.0.0.1

# Port di komputer ini yang disambungkan ke port 5005 di dalam kontainer.
# Ubah bila port 5005 sudah dipakai program lain.
FACE_PUBLISH_PORT=5005

# Bentuk potret bukti absen yang dikirim bersama hasil pengenalan wajah.
#
# Potret ini yang disimpan aplikasi sekolah sebagai bukti absen. Sisi
# terpanjangnya diperkecil dulu, lalu mutu JPEG-nya diturunkan berulang sampai
# masuk batas ukuran. Foto aslinya tidak pernah diperbesar.
FACE_PROOF_MAX_SIDE=480
FACE_PROOF_QUALITY=72
FACE_PROOF_MAX_KB=48

# Pemeriksaan wajah pada satu bingkai.
#
# FACE_DETECT_MAX_SIDE adalah sisi terpanjang gambar yang dipakai untuk
# mendeteksi wajah. Foto besar dari ponsel diperkecil dulu supaya deteksinya
# tidak lambat di mesin tanpa kartu grafis; koordinat kotak wajah tetap
# dikembalikan ke skala gambar asli.
#
# FACE_MAX_FACES adalah paling banyak wajah yang dihitung dalam satu gambar.
# Isi 0 untuk tidak membatasi. Bingkai yang memuat lebih banyak orang daripada
# angka ini tetap dilaporkan, tetapi hanya wajah terbesar yang dihitung.
FACE_DETECT_MAX_SIDE=1024
FACE_MAX_FACES=8
