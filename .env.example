# Salin berkas ini menjadi .env bila perlu mengubah pengaturan bawaan.
# Semua nilai di bawah sudah punya bawaan di docker-compose.yml, jadi .env
# tidak wajib dibuat.

# Alamat tempat port layanan wajah dibuka di komputer ini.
#
# 127.0.0.1  hanya bisa dihubungi dari komputer ini sendiri (bawaan, paling aman).
# 0.0.0.0    bisa dihubungi dari komputer lain di jaringan sekolah.
#
# Layanan ini tidak punya kata sandi, jadi 0.0.0.0 hanya dipakai bila mesin
# wajahnya memang dipisah dari aplikasi sekolah, dan sebaiknya dibatasi
# firewall.
FACE_PUBLISH_HOST=127.0.0.1

# Port di komputer ini yang disambungkan ke port 5005 di dalam kontainer.
# Ubah bila port 5005 sudah dipakai program lain.
FACE_PUBLISH_PORT=5005
